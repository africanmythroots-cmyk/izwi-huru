{
  "name": "izwi-huru-backend",
  "version": "0.1.0",
  "description": "Izwi Huru — pan-African free-speech platform backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node --import tsx/esm scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "altcha": "^1.3.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.5",
    "postgres": "^3.4.4",
    "zod": "^3.23.8",
    "bip39": "^3.1.0",
    "crypto": "builtin"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.6",
    "eslint": "^9.6.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
