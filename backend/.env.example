# Environment variables for Izwi Huru backend
# Copy to .env and fill in values before starting.
# NEVER commit the filled .env file to version control.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=postgres://izwihuru:CHANGE_THIS_PASSWORD@localhost:5432/izwihuru

# Redis (Valkey) connection string
REDIS_URL=redis://127.0.0.1:6379

# AES-256-GCM key for post body encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BODY_ENCRYPT_KEY=GENERATE_64_HEX_CHARS_HERE

# Altcha HMAC secret for PoW CAPTCHA challenge signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALTCHA_SECRET=GENERATE_RANDOM_STRING_MIN_32_CHARS

# Session duration in days
SESSION_DAYS=30

# Max registration attempts per IP per hour (generous for Tor)
REG_RATE_LIMIT=10
